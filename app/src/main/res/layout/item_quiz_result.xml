<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="180dp"
    android:layout_height="220dp"
    android:layout_marginEnd="16dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/grey_light"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/courseColorIndicator"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@drawable/quiz_item_header_bg"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/tvCourseName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="Web Development"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tvQuizScore"
            app:layout_constraintTop_toTopOf="@id/courseColorIndicator"
            app:layout_constraintBottom_toBottomOf="@id/courseColorIndicator"
            app:layout_constraintVertical_bias="0.5" />

        <TextView
            android:id="@+id/tvQuizScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="7/10"
            android:textSize="14sp"
            android:textColor="@color/white"
            android:background="@drawable/score_badge_background"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/courseColorIndicator"
            app:layout_constraintBottom_toBottomOf="@id/courseColorIndicator"
            app:layout_constraintVertical_bias="0.5" />

        <TextView
            android:id="@+id/tvQuizTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:text="Responsive Design Principles"
            android:textColor="@color/contentTextColor"
            android:textSize="16sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/courseColorIndicator" />

        <!-- Lesson Info -->
        <TextView
            android:id="@+id/tvLessonInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/lesson_badge_background"
            android:fontFamily="sans-serif"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Bài 2"
            android:textColor="@color/dashboard_subtitle"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvQuizTitle" />

        <!-- Date with icon -->
        <ImageView
            android:id="@+id/ivCalendarIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/calendar"
            android:contentDescription="Date icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvLessonInfo"
            app:tint="@color/dashboard_subtitle" />

        <TextView
            android:id="@+id/tvQuizDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:fontFamily="sans-serif"
            android:text="14/05/2024"
            android:textColor="@color/dashboard_subtitle"
            android:textSize="12sp"
            app:layout_constraintStart_toEndOf="@+id/ivCalendarIcon"
            app:layout_constraintTop_toTopOf="@+id/ivCalendarIcon"
            app:layout_constraintBottom_toBottomOf="@+id/ivCalendarIcon" />

        <!-- Progress Bar with Label -->
        <TextView
            android:id="@+id/tvAccuracyLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="4dp"
            android:fontFamily="sans-serif"
            android:text="Accuracy"
            android:textColor="@color/dashboard_subtitle"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/progressQuiz" />

        <TextView
            android:id="@+id/tvAccuracyPercentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:fontFamily="sans-serif-medium"
            android:text="70%"
            android:textColor="@color/bright_orange"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/tvAccuracyLabel" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progressQuiz"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:progress="70"
            app:indicatorColor="@color/bright_orange"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:trackColor="@color/grey_light"
            app:trackThickness="4dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
